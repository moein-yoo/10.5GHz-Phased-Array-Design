TECHFORMAT=V2

UNITS
  DISTANCE=METRE
  CONDUCTIVITY=SIEMENS/M
  RESISTIVITY=OHM.CM
  RESISTANCE=OHM/SQ
  PERMITTIVITY=RELATIVETOVACUUM
  PERMEABILITY=RELATIVETOVACUUM
  FREQUENCY=HZ
  TEMPERATURE=CELSIUS
END_UNITS

BEGIN_MATERIAL
  MATERIAL Demo_GaAs PERMITTIVITY=12.9 LOSSTANGENT=0.0016 PERMEABILITY=1 IMAG_PERMEABILITY=0
  MATERIAL Demo_Nit1 PERMITTIVITY=7.5 LOSSTANGENT=0.0005 PERMEABILITY=1 IMAG_PERMEABILITY=0
  MATERIAL Demo_Nit2 PERMITTIVITY=7.5 LOSSTANGENT=0.0005 PERMEABILITY=1 IMAG_PERMEABILITY=0
  MATERIAL Demo_Nit3 PERMITTIVITY=7.5 LOSSTANGENT=0.0005 PERMEABILITY=1 IMAG_PERMEABILITY=0
  MATERIAL Demo_Poly PERMITTIVITY=2.7 LOSSTANGENT=0.008 PERMEABILITY=1 IMAG_PERMEABILITY=0
  MATERIAL mesa RESISTANCE=250 IMAG_RESISTANCE=0 PERMEABILITY=1
  MATERIAL nicr RESISTANCE=50 IMAG_RESISTANCE=0 PERMEABILITY=1
  MATERIAL top PERMITTIVITY=1 LOSSTANGENT=0 PERMEABILITY=1 IMAG_PERMEABILITY=0
END_MATERIAL

BEGIN_OPERATION
  OPERATION OperationSHEET SHEET
  OPERATION OperationThickness_mesa INTRUDE=1e-08 UP
  OPERATION OperationThickness_nicr INTRUDE=5e-08 UP
  OPERATION OperationThickness_M0 INTRUDE=1e-06 UP
  OPERATION OperationThickness_M1 INTRUDE=1e-06 UP
  OPERATION OperationThickness_M2 INTRUDE=1e-06 UP
  OPERATION OperationThickness_demo_dummy INTRUDE=1e-06 UP
  OPERATION OperationDRILL DRILL
  OPERATION OperationTSV_Via_Nit1 DRILL
  OPERATION OperationTSV_Via0_1 DRILL
  OPERATION OperationTSV_Via1_2 DRILL
  OPERATION OperationTSV_Via_Pass DRILL
  OPERATION OperationTSV_BVia DRILL
END_OPERATION

BEGIN_MASK
  MASK 1 Name=mesa PRECEDENCE=0 COLOR="ee6a50" MATERIAL=mesa OPERATION=OperationThickness_mesa MASK_PROPERTIES = { "MomModelType=operation2sheet" }
  MASK 2 Name=nicr PRECEDENCE=0 COLOR="696969" MATERIAL=nicr OPERATION=OperationThickness_nicr MASK_PROPERTIES = { "MomModelType=operation2sheet" }
  MASK 3 Name=Via_Nit1 PRECEDENCE=0 COLOR="76eec6" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationDRILL
  MASK 4 Name=M0 PRECEDENCE=0 COLOR="4169e1" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationThickness_M0 MASK_PROPERTIES = { "MomModelType=operation2sheet" }
  MASK 5 Name=Via0_1 PRECEDENCE=0 COLOR="00bfff" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationDRILL
  MASK 6 Name=M1 PRECEDENCE=0 COLOR="00ff00" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationThickness_M1 MASK_PROPERTIES = { "MomModelType=operation2sheet" }
  MASK 7 Name=Via1_2 PRECEDENCE=0 COLOR="0000ff" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationDRILL
  MASK 8 Name=M2 PRECEDENCE=0 COLOR="ff0000" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationThickness_M2 MASK_PROPERTIES = { "MomModelType=operation2sheet" }
  MASK 9 Name=Via_Pass PRECEDENCE=0 COLOR="caff70" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationDRILL
  MASK 10 Name=BVia PRECEDENCE=0 COLOR="eed5d2" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationDRILL
  MASK 11 Name=demo_dummy PRECEDENCE=0 COLOR="ffe4e1" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationThickness_demo_dummy MASK_PROPERTIES = { "MomModelType=operation2sheet" }
END_MASK

BEGIN_STACK
  TOP OPEN MATERIAL=top
  INTERFACE Name=__Interface5     
  LAYER     Name=__SubstrateLayer5 MASK={Via_Pass} HEIGHT=1.2e-07 MATERIAL=Demo_Nit3
  INTERFACE Name=__Interface4      MASK={M2}
  LAYER     Name=__SubstrateLayer4 MASK={Via1_2} HEIGHT=1e-06 MATERIAL=Demo_Poly
  INTERFACE Name=__Interface3      MASK={M1}
  LAYER     Name=__SubstrateLayer3 MASK={Via0_1} HEIGHT=1e-07 MATERIAL=Demo_Nit2
  INTERFACE Name=__Interface2      MASK={M0}
  LAYER     Name=__SubstrateLayer2 MASK={Via_Nit1} HEIGHT=1.2e-07 MATERIAL=Demo_Nit1
  INTERFACE Name=__Interface1      MASK={mesa nicr demo_dummy}
  LAYER     Name=__SubstrateLayer1 MASK={BVia} HEIGHT=0.0001 MATERIAL=Demo_GaAs
  BOTTOM COVERED MATERIAL=PERFECT_CONDUCTOR
END_STACK

